{
  "name": "payment-tracker",
  "version": "1.0.0",
  "description": "Mini payment tracker for a learning center",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "sequelize": "^6.37.5",
